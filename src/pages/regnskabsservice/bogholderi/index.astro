---
import Layout from '../../../components/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SeoHead from '../../../components/SeoHead.astro';
import { org } from '../../../data/site.ts';
const B = import.meta.env.BASE_URL;
const title = 'Bogholderi — skræddersyet bogholderi | Elgård Regnskab';
const description = 'Skræddersyet bogholderi: vi registrerer dine bilag, eller du gør det selv og sender os listen. Opsætning, kørselsregnskab og klargøring til revision.';
const path = '/regnskabsservice/bogholderi/';
const crumbObj = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Forside', item: 'https://elgard.dk/' },
    { '@type': 'ListItem', position: 2, name: 'Regnskabsservice', item: 'https://elgard.dk/regnskabsservice/' },
    { '@type': 'ListItem', position: 3, name: 'Bogholderi', item: `https://elgard.dk${path}` },
  ],
};
const items = [
  { name: 'Opsætning i regnskabsprogram', text: 'Vi får dit bogholderi opstillet, så det passer til din virksomhedstype og dine vaner — fra dag én.' },
  { name: 'Indtastning af bilag', text: 'Hvert bilag registreres, så kørselsregnskabet altid er aktuelt og du altid kan se, hvor du står.' },
  { name: 'Kørselsregnskab', text: 'Løbende overblik over indtægter, udgifter og resultat — med det samme tal, som årsregnskabet bygger på.' },
  { name: 'Klargøring af regnskab til revision', text: 'Regnskabet klargøres, så revisionspåtegning går hurtigt og uden overraskelser.' },
];
---

<Layout>
  <Fragment slot="head">
    <SeoHead title={title} description={description} path={path} jsonld={[crumbObj]} />
  </Fragment>
  <Header />
  <main>
    <section class="page-head wrap">
      <h1>Bogholderi</h1>
      <p class="lead">Skræddersyet bogholderi — på den måde, der passer til dig.</p>
    </section>
    <section class="section wrap" style="padding-top: 0;">
      <div class="inner-grid">
        <div>
          <h2 class="head" style="margin-top: 3rem; font-size: var(--step-lead);">Skræddersyet bogholderi — på den måde, der passer til dig</h2>
          <p class="prose">
            Hos Elgård Regnskab tilbyder vi skræddersyet bogholderiservice, der passer til
            netop din virksomhed — og til den måde, du selv har lyst til at arbejde på.
            Foretrækker du at aflevere alle dine bilag til os, fx hver måned, og lade os stå
            for registrering af hvert bilag — så gør vi det.
          </p>
          <p class="prose">
            Omvendt har vi også mange kunder, som foretrækker selv at registrere deres bilag
            og derpå aflevere listen til os, fx som en excel-fil. Herefter kan vi sætte
            regnskabet op, så kørselsregnskabet altid er aktuelt.
          </p>
          <h2 class="head" style="margin-top: 3rem; font-size: var(--step-lead);">Alt efter dit behov kan bogholderiservice indeholde:</h2>
          <ul class="sublist">
            {items.map((s) => (
              <li><strong>{s.name}</strong> — {s.text}</li>
            ))}
          </ul>
        </div>
        <div>
          <div class="aside">
            <div class="aside-card">
              <h3>Sådan kan vi klare det</h3>
              <ul>
                <li>Aflever dine bilag til os, fx hver måned</li>
                <li>Eller registrer selv og send os listen (excel-fil)</li>
                <li>Vi opsætter regnskabet, så det passer til dig</li>
                <li>Kørselsregnskab og klargøring til revision</li>
              </ul>
            </div>
            <div class="aside-card">
              <h3>Kontakt</h3>
              <dl>
                <div><dt>Direkte</dt><dd><a class="link-plain" href={org.phoneHref}>{org.phone}</a></dd></div>
                <div><dt>Kontor</dt><dd><a class="link-plain" href={org.officePhoneHref}>{org.officePhone}</a></dd></div>
                <div><dt>Adresse</dt><dd>{org.street}, {org.city}</dd></div>
                <div><dt>Åbent</dt><dd>{org.hours}</dd></div>
              </dl>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
