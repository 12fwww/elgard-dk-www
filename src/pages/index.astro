---
import { Picture, Image } from 'astro:assets';
import Layout from '../components/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import { org } from '../data/site.ts';
import { services } from '../data/site.ts';
import { branches } from '../data/site.ts';
import { faq } from '../data/site.ts';
import { pickerTasks } from '../data/site.ts';
import { foundCredit } from '../data/site.ts';
import liselotte from '../assets/original/liselotte.jpg';
import logo from '../assets/original/logo.png';
import birkerod from '../assets/original/birkerod.jpg';
import annemette from '../assets/original/annemette.jpg';
import liselottePortrait from '../assets/original/liselotte-portrait.jpg';
const B = import.meta.env.BASE_URL;
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'AccountingService',
  name: org.name,
  url: 'https://elgard.dk/',
  logo: logo.src,
  telephone: '+45 2684 9809',
  email: org.email,
  priceRange: '€€',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'RevisorHuset, Blokken 90',
    postalCode: '3460',
    addressLocality: 'Birkerød',
    addressCountry: 'DK',
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'], opens: '09:00', closes: '16:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Friday', opens: '09:00', closes: '15:00' },
  ],
};
const title = 'Mere tid til forretning og familie | Elgård Regnskab';
const description = 'Bogholderi, regnskab, moms og skat for selvstændige i Birkerød. Frister, afregninger og årsregnskab klaret — tid til forretning og familie. Ring 2684 9809.';
const sumTotal = pickerTasks.reduce((s, t) => s + t.est, 0);
---

<Layout>
  <Fragment slot="head">
    <SeoHead title={title} description={description} path="/" image={liselotte} jsonld={[localBusiness]} />
  </Fragment>

  <Header />

  <main>
    <section class="hero wrap" aria-label="Forside">
      <div class="hero-grid">
        <div class="hero-text" data-reveal>
          <h1 class="hero-name">Velkommen hos Elgård Regnskab</h1>
          <p class="hero-support">
            Vi klarer bogføring, frister, moms og regnskab — så du behøver bare at være
            selvstændig.
          </p>
          <div class="hero-cta">
            <a class="button" href={org.phoneHref}>Ring {org.phone}</a>
          </div>
        </div>
        <div class="hero-panel" data-reveal>
          <p class="hero-sentence">Mere tid til forretning og familie</p>
          <ul class="hero-points">
            <li>Frister og moms afregnet til tiden</li>
            <li>Løbende bogføring, så regnskabet stemmer</li>
            <li>Personlig rådgivning, der giver mening</li>
          </ul>
        </div>
        <figure class="hero-figure">
          <Picture src={annemette} formats={['avif', 'webp']} widths={[340, 512, 722]} sizes="(min-width: 56em) 30rem, (min-width: 48em) 22rem, 88vw" alt="På kontoret hos Elgård Regnskab, RevisorHuset i Birkerød" loading="eager" />
          <figcaption class="hero-credit">Kontoret i Birkerød</figcaption>
        </figure>
      </div>
    </section>

    <section class="picker section wrap" aria-labelledby="picker-h">
      <div class="grid">
        <div style="grid-column: 1 / -1;">
          <h2 id="picker-h" class="picker-head">Hvad overdrer vi?</h2>
          <p class="picker-intro">
            Vælg det, du gider mindst at bruge tid på. Vi estimerer, hvor meget det koster
            dig om ugen.
          </p>
          <div class="chips" id="picker-chips" data-reveal>
            {pickerTasks.map((t) => (
              <button class="chip" type="button" data-label={t.label} aria-pressed="false">
                {t.label} <span class="est">≈ {t.est} t/u</span>
              </button>
            ))}
          </div>
          <p class="sumline" id="picker-sum" role="status" data-reveal>
            Vælg én eller flere opgaver, og se, hvor meget tid du får tilbage.
          </p>
          <p class="picker-fallback" data-reveal>
            Typiske estimater for små selvstændige virksomheder: bogføring ca. 4
            timer/uge, moms og selvangivelse ca. 2, lønadministration ca. 3, frister og
            korrespondance ca. 2 samt årsregnskab ca. 3 timer fordelt over året. Alt
            sammen er det ca. {sumTotal} timer om ugen, du kan bruge på forretning og
            familie.
          </p>
        </div>
      </div>
    </section>

    <section class="section wrap" aria-labelledby="svc-h">
      <h2 id="svc-h" class="head" data-reveal>Alt det, dit regnskab rører</h2>
      <p class="features-note" data-reveal>
        <a class="link-plain" href={`${B}/regnskabsservice/bogholderi/`}>Bogholderi</a>,
        <a class="link-plain" href={`${B}/regnskabsservice/`}>regnskab</a>,
        <a class="link-plain" href={`${B}/moms-skat/`}>moms, told og skat</a>,
        <a class="link-plain" href={`${B}/regnskabsservice/`}>fakturering</a> og
        <a class="link-plain" href={`${B}/regnskabsservice/`}>lønadministration</a> —
        samlet ét sted. Revision og påtegning klarer vi i samarbejde med
        <a class="link-plain" href={`${B}/regnskabsservice/revision/`}>statsautoriseret revisor
        Claus Carlsen</a>.
      </p>
      <ul class="sublist" data-reveal>
        {services.map((s) => (
          <li>
            <a href={s.href}>{s.name}</a> — {s.text}
          </li>
        ))}
      </ul>
    </section>

    <section class="proof section wrap" aria-labelledby="proof-h">
      <div class="proof-grid">
        <div>
          <h2 id="proof-h" class="head" data-reveal>Vi kender regnskabet fra</h2>
          <ul class="branch-pills" data-reveal>
            {branches.map((b) => (
              <li class="branch-pill">{b}</li>
            ))}
          </ul>
        </div>
        <figure class="street-figure" data-reveal>
          <Picture src={birkerod} formats={['avif', 'webp']} widths={[480, 960, 1440, 1920]} sizes="(min-width: 48em) 39rem, 94vw" alt="Birkerød Hovedgade" loading="lazy" />
          <figcaption>
            Birkerød Hovedgade — {foundCredit.license}, via {foundCredit.via}.
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="section wrap" aria-labelledby="om-h">
      <h2 id="om-h" class="head" data-reveal>Liselotte Elgård Nielsen</h2>
      <div class="about-grid">
        <div>
          <p class="about-bio" data-reveal>
            Uddannet revisor med mange års erfaring for store, mellemstore og små virksomheder.
            Hun sætter en ære i at tale, så enhver kan forstå, hvad sagen handler om — og
            guider mindre og mellemstore virksomheder igennem junglen af papirer fra det
            offentlige, så frister vedrørende skat og moms overholdes.
          </p>
          <dl class="about-facts" data-reveal>
            <div><dt>Adresse</dt><dd>{org.street}, {org.city}</dd></div>
            <div><dt>CVR</dt><dd>{org.cvr}</dd></div>
            <div><dt>Åbent</dt><dd>{org.hours}</dd></div>
          </dl>
        </div>
        <figure class="portrait-side" data-reveal>
          <Image src={liselottePortrait} alt="Liselotte Elgård Nielsen, revisor og indehaver af Elgård Regnskab" loading="lazy" />
          <figcaption>Liselotte Elgård Nielsen, revisor</figcaption>
        </figure>
      </div>
    </section>

    <section class="section wrap" aria-labelledby="faq-h">
      <div class="faq-grid">
        <div>
          <h2 id="faq-h" class="faq-q" data-reveal>Hvad kunderne spørger til</h2>
          <p class="faq-side" data-reveal>
            Spørgsmålene fra de selvstændige, vi sidder for hver uge. Kan du ikke finde
            dit svar, så ring — vi besvarer telefonen alle hverdage 9–16.
          </p>
        </div>
        <div class="faq-list" data-reveal>
          {faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p class="faq-a">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="close">
      <div class="wrap" style="display: flex; flex-direction: column; align-items: center; text-align: center;">
        <h2 data-reveal>Ring i dag. Resten klarer vi.</h2>
        <div class="close-row" data-reveal>
          <p>
            {org.phoneHours}. Eller skriv: <a class="link-plain" href={org.emailHref}>{org.email}</a>.
          </p>
          <a class="button" href={org.phoneHref}>Ring {org.phone}</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    const chips = Array.from(document.querySelectorAll('.chip'));
    const sumEl = document.getElementById('picker-sum');
    const ests = new Map(chips.map((c) => [c.dataset.label, 0]));
    for (const c of chips) {
      const est = c.querySelector('.est');
      if (est) ests.set(c.dataset.label, Number((est.textContent || '').replace(/[^\d]/g, '')) || 0);
    }
    const selected = new Set();
    const render = () => {
      const total = Array.from(selected).reduce((s, l) => s + (ests.get(l) || 0), 0);
      chips.forEach((c) => c.setAttribute('aria-pressed', String(selected.has(c.dataset.label))));
      if (sumEl) {
        if (total > 0) {
          sumEl.innerHTML = 'Det svarer til ca. <strong>' + total + ' timer om ugen</strong>, du får tilbage — til din forretning og din familie.';
        } else {
          sumEl.textContent = 'Vælg én eller flere opgaver, og se, hvor meget tid du får tilbage.';
        }
      }
    };
    for (const c of chips) {
      c.addEventListener('click', () => {
        selected.has(c.dataset.label) ? selected.delete(c.dataset.label) : selected.add(c.dataset.label);
        render();
      });
    }
  </script>
</Layout>
