---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  title: string;
  description: string;
  path: string;
  image?: ImageMetadata;
  jsonld?: object[];
  type?: 'website' | 'article';
}
const { title, description, path, image, jsonld = [], type = 'website' } = Astro.props;
const production = (import.meta.env.PUBLIC_PRODUCTION_URL || Astro.site?.origin || '').replace(/\/$/, '');
const preview = import.meta.env.PUBLIC_PREVIEW !== '0';
const canonical = production + path;
const og = image ? await getImage({ src: image, width: 1200, format: 'jpg' }) : null;
const ogUrl = og ? new URL(og.src, Astro.site).href : undefined;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{preview && <meta name="robots" content="noindex, follow" />}
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{ogUrl && <meta property="og:image" content={ogUrl} />}
{og && <meta property="og:image:width" content={String(og.attributes.width ?? 1200)} />}
<meta name="twitter:card" content={ogUrl ? 'summary_large_image' : 'summary'} />
{jsonld.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
