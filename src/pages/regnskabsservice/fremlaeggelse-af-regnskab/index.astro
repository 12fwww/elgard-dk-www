---
import Layout from '../../../components/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SeoHead from '../../../components/SeoHead.astro';
import { org } from '../../../data/site.ts';
const B = import.meta.env.BASE_URL;
const title = 'Fremlæggelse af regnskab | Elgård Regnskab';
const description = 'Personligt fremmøde ved generalforsamling eller bestyrelse: vi præsenterer års- og kvartalsregnskaberne mundtligt, så tallene forklares, når de skal forklares.';
const path = '/regnskabsservice/fremlaeggelse-af-regnskab/';
const crumbObj = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Forside', item: 'https://elgard.dk/' },
    { '@type': 'ListItem', position: 2, name: 'Regnskabsservice', item: 'https://elgard.dk/regnskabsservice/' },
    { '@type': 'ListItem', position: 3, name: 'Fremlæggelse af regnskab', item: `https://elgard.dk${path}` },
  ],
};
---

<Layout>
  <Fragment slot="head">
    <SeoHead title={title} description={description} path={path} jsonld={[crumbObj]} />
  </Fragment>
  <Header />
  <main>
    <section class="page-head wrap">
      <h1>Fremlæggelse af regnskab</h1>
      <p class="lead">Når regnskabet skal præsenteres, er vi der.</p>
    </section>
    <section class="section wrap" style="padding-top: 0;">
      <p style="max-width: 58ch;">
        Nogle virksomheder og foreninger har behov for mundtlige præsentationer i
        forbindelse med års- eller kvartalsregnskaber.
      </p>
      <p style="max-width: 58ch;">
        Her kan vi tilbyde personligt fremmøde i forbindelse med fremlæggelse af jeres
        regnskab for fx en generalforsamling eller en bestyrelse — så tallene forklares,
        når de skal forklares, og spørgsmalerne besvares, imens de stadig er relevante.
      </p>
      <div class="contact-card" style="margin-top: 3.5rem;">
        <dl>
          <div><dt>Kontakt</dt><dd><a class="link-plain" href={org.phoneHref}>Direkte {org.phone}</a> · <a class="link-plain" href={org.officePhoneHref}>Kontor {org.officePhone}</a> · <a class="link-plain" href={org.emailHref}>{org.email}</a></dd></div>
          <div><dt>Kontor</dt><dd>{org.street}, {org.city} · CVR {org.cvr}</dd></div>
          <div><dt>Åbent</dt><dd>{org.hours}. {org.phoneHours}.</dd></div>
        </dl>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
