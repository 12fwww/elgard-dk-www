---
import Layout from '../../components/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SeoHead from '../../components/SeoHead.astro';
import { org } from '../../data/site.ts';
import { crumb } from '../../data/site.ts';
const B = import.meta.env.BASE_URL;
const title = 'Velkommen til Elgård Regnskab | Elgård Regnskab';
const description = 'Mere tid til forretning og familie: vi sørger for frister, skat, moms og bogføring, så dine regnskaber stemmer. Hver gang. Ring 2684 9809.';
const path = '/hello-world/';
---

<Layout>
  <Fragment slot="head">
    <SeoHead title={title} description={description} path={path} jsonld={[crumb('Velkommen', path)]} />
  </Fragment>
  <Header />
  <main>
    <section class="page-head wrap">
      <h1>Velkommen til Elgård Regnskab</h1>
      <p class="lead">Mere tid til forretning og familie.</p>
    </section>
    <section class="section wrap" style="padding-top: 0;">
      <p style="max-width: 58ch;">
        Mange selvstændige bruger alt for meget tid på administrative opgaver som
        bogføring og regnskab. Mange mister endda også penge på grund af glemte frister,
        for sent afregnet moms — eller manglende fradrag, fordi de ikke kender de nyeste
        skatteregler.
      </p>
      <p style="max-width: 58ch;">
        Hos Elgård Regnskabsservice sørger vi for, at du overholder alle frister, får styr
        på skatten, afregnet momsen og klaret den løbende bogføring. Vi udarbejder dine
        regnskaber, så de stemmer. <strong>Hver gang.</strong>
      </p>
      <p style="max-width: 58ch;">
        Og den tid, du sparer? Den kan du bruge på at drive og udvikle din forretning — og
        nyde livet sammen med familien.
      </p>
      <p style="max-width: 58ch;">
        Læs mere om os og vores ydelser
        <a class="link-plain" href={`${B}/regnskabsservice/`}>her på siderne</a>. Eller
        ring og tal med os om, hvad vi kan gøre for dig. Telefon {org.phone} — vi svarer
        alle hverdage 9–16.
      </p>
      <div class="contact-card" style="margin-top: 3.5rem;">
        <dl>
          <div><dt>Elgård Regnskab</dt><dd>{org.founder}, revisor</dd></div>
          <div><dt>Adresse</dt><dd>{org.street}, {org.city}</dd></div>
          <div><dt>Telefon</dt><dd><a class="link-plain" href={org.phoneHref}>{org.phone}</a> (alle hverdage 9–16) · <a class="link-plain" href={org.officePhoneHref}>Kontor {org.officePhone}</a></dd></div>
          <div><dt>E-mail</dt><dd><a class="link-plain" href={org.emailHref}>{org.email}</a></dd></div>
          <div><dt>CVR</dt><dd>{org.cvr}</dd></div>
        </dl>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
