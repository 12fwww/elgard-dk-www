---
import { nav } from '../data/site.ts';
import { org } from '../data/site.ts';
import { towns } from '../data/site.ts';
const B = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<footer class="footer">
  <div class="wrap">
    <div class="footer-top">
      <img src={B + "/assets/logo.webp"} alt="Elgård Regnskab" width="1177" height="420" class="logo" />
      <div class="footer-cols">
        <div>
          <h3>Kontakt</h3>
          <p>
            {org.street}<br />
            {org.city}<br />
            <a class="link-plain" href={org.emailHref}>{org.email}</a><br />
            CVR {org.cvr}
          </p>
          <p class="footer-hours">{org.hours}.<br />{org.phoneHours}.</p>
        </div>
        <div>
          <h3>Vi hjælper kunder i</h3>
          <p class="footer-towns">{towns.join(', ')}</p>
        </div>
      </div>
    </div>
    <a class="footer-phone" href={org.phoneHref}>
      <span class="sr-only">Ring til Elgård Regnskab på </span>{org.phone}
    </a>
    <div class="footer-meta">
      <nav aria-label="Sidemeny">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <p>© {new Date().getFullYear()} {org.name}</p>
    </div>
  </div>
</footer>
