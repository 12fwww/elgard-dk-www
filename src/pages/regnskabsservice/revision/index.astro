---
import Layout from '../../../components/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SeoHead from '../../../components/SeoHead.astro';
import { org } from '../../../data/site.ts';
const B = import.meta.env.BASE_URL;
const title = 'Revision — revisionspåtegning | Elgård Regnskab';
const description = 'Revisionspåtegning i samarbejde med statsautoriseret revisor Claus Carlsen — bogføring og administration sammensat til jeres behov.';
const path = '/regnskabsservice/revision/';
const crumbObj = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Forside', item: 'https://elgard.dk/' },
    { '@type': 'ListItem', position: 2, name: 'Regnskabsservice', item: 'https://elgard.dk/regnskabsservice/' },
    { '@type': 'ListItem', position: 3, name: 'Revision', item: `https://elgard.dk${path}` },
  ],
};
---

<Layout>
  <Fragment slot="head">
    <SeoHead title={title} description={description} path={path} jsonld={[crumbObj]} />
  </Fragment>
  <Header />
  <main>
    <section class="page-head wrap">
      <h1>Revision</h1>
      <p class="lead">
        Har du behov for — eller direkte krav om — revisionspåtegning af dit selskabs
        regnskaber?
      </p>
    </section>
    <section class="section wrap" style="padding-top: 0;">
      <div class="inner-grid">
        <div>
          <h2 class="head" style="margin-top: 3rem; font-size: var(--step-lead);">Samarbejde med statsautoriseret revisor</h2>
          <p class="prose">
            Har du behov for — eller direkte krav om — revisionspåtegning af dit selskabs
            regnskaber? Vi står for den løbende bogføring og administration, og påtegningen
            klarer vi i samarbejde med en statsautoriseret revisor.
          </p>
          <h2 class="head" style="margin-top: 3rem; font-size: var(--step-lead);">Bogføring, administration og revision sammensat til jeres behov</h2>
          <p class="prose">
            Elgård Regnskab samarbejder med statsautoriseret revisor
            <a class="link-plain" href="http://rygecarlsen.dk/" target="_blank" rel="noopener">Claus Carlsen</a>.
            Samarbejdet giver mulighed for, at vi kan sammensætte opgaver omkring bogføring,
            administration og revision på den måde, der passer bedst til din virksomheds
            behov — fra den løbende bogføring til selve påtegningen.
          </p>
        </div>
        <div>
          <div class="aside">
            <div class="aside-card">
              <h3>Revision hos os</h3>
              <ul>
                <li>Revisionspåtegning via statsautoriseret revisor Claus Carlsen</li>
                <li>Løbende bogholderi og administration, klar til revision</li>
                <li>Samlet løsning, der passer til din virksomhed</li>
              </ul>
            </div>
            <div class="aside-card">
              <h3>Kontakt</h3>
              <dl>
                <div><dt>Direkte</dt><dd><a class="link-plain" href={org.phoneHref}>{org.phone}</a></dd></div>
                <div><dt>Kontor</dt><dd><a class="link-plain" href={org.officePhoneHref}>{org.officePhone}</a></dd></div>
                <div><dt>Adresse</dt><dd>{org.street}, {org.city}</dd></div>
                <div><dt>Åbent</dt><dd>{org.hours}</dd></div>
              </dl>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
