---
import Layout from '../../components/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SeoHead from '../../components/SeoHead.astro';
import { org } from '../../data/site.ts';
import { crumb } from '../../data/site.ts';
const B = import.meta.env.BASE_URL;
const title = 'Rådgivning og kurser | Elgård Regnskab';
const description = 'Rådgivning der passer til din situation: opstart, pension, klargøring til revision — og kurser for iværksættere med revisor Liselotte Elgård Nielsen.';
const path = '/raadgivning-og-kurser/';
const faqObj = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Hvilken pension rådgiver I i?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Vi rådgiver om medarbejderpension — pension, der skal udbetales til medarbejdere med krav herpå, fx fastsat gennem overenskomst — og om pensionsordninger for selvstændige.',
      },
    },
    {
      '@type': 'Question',
      name: 'Holder I kurser?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Ja. Med sin store viden og solide praktiske baggrund er Liselotte Elgård Nielsen en efterspurgt oplægsholder — ikke mindst i forbindelse med møder og kurser for iværksættere.',
      },
    },
  ],
};
---

<Layout>
  <Fragment slot="head">
    <SeoHead title={title} description={description} path={path} jsonld={[crumb('Rådgivning og kurser', path), faqObj]} />
  </Fragment>
  <Header />
  <main>
    <section class="page-head wrap">
      <h1>Rådgivning og kurser</h1>
      <p class="lead">Rådgivning, der passer til din situation — og som kan forstås.</p>
    </section>
    <section class="section wrap" style="padding-top: 0;">
      <div class="inner-grid">
        <div>
          <p class="prose">
            Rådgivning, der passer til din situation — og som kan forstås. Liselotte
            Elgård Nielsen er uddannet revisor og har mange års erfaring med både regnskaber,
            revision og rådgivning. Hendes mangeårige virke har givet hende en solid indsigt
            i forholdene for både større, mindre og små virksomheder.
          </p>
          <p class="prose">
            Liselotte guider mindre og mellemstore virksomheder igennem junglen af papirer
            fra det offentlige — og skaber overblik, der sikrer, at der kommer styr på bl.a.
            overholdelse af diverse frister vedrørende skat og moms.
          </p>
          <h2 class="head" style="margin-top: 3rem; font-size: var(--step-lead);">Rådgivning, der passer til din situation</h2>
          <p class="prose">
            Liselotte hjælper opstartsvirksomheder i gang med indretning af bogholderiet,
            planlægning af momsafregningen samt forskudsopgørelsen og næste års
            selvangivelse. De større virksomheder med flere ansatte får blandt andet
            rådgivning i forbindelse med tilrettelæggelse af bogholderiet og klargøring af
            regnskaber til revision.
          </p>
          <h2 class="head" style="margin-top: 3rem; font-size: var(--step-lead);">Kurser for iværksættere</h2>
          <p class="prose">
            Med sin store viden og solide praktiske baggrund er Liselotte Elgård Nielsen en
            efterspurgt oplægsholder — ikke mindst i forbindelse med møder og kurser for
            iværksættere.
          </p>
        </div>
        <div>
          <div class="aside">
            <div class="aside-card">
              <h3>Rådgivning om pension</h2>
              <ul>
                <li>Medarbejderpension — herunder krav fastsat gennem overenskomst</li>
                <li>Pensionsordninger for selvstændige</li>
              </ul>
            </div>
            <div class="aside-card">
              <h3>Opstart og overblik</h3>
              <ul>
                <li>Indretning af bogholderiet</li>
                <li>Planlægning af momsafregning og forskudsopgørelse</li>
                <li>Næste års selvangivelse</li>
              </ul>
            </div>
            <div class="aside-card">
              <h3>Kontakt</h3>
              <dl>
                <div><dt>Direkte</dt><dd><a class="link-plain" href={org.phoneHref}>{org.phone}</a></dd></div>
                <div><dt>Kontor</dt><dd><a class="link-plain" href={org.officePhoneHref}>{org.officePhone}</a></dd></div>
                <div><dt>Adresse</dt><dd>{org.street}, {org.city}</dd></div>
                <div><dt>Åbent</dt><dd>{org.hours}</dd></div>
              </dl>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
