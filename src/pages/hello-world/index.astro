---
import { Picture } from 'astro:assets';
import Layout from '../../components/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SeoHead from '../../components/SeoHead.astro';
import { org } from '../../data/site.ts';
import { crumb } from '../../data/site.ts';
import annemette from '../../assets/original/annemette.jpg';
const B = import.meta.env.BASE_URL;
const title = 'Velkommen til Elgård Regnskab | Elgård Regnskab';
const description = 'Mere tid til forretning og familie: vi sørger for frister, skat, moms og bogføring, så dine regnskaber stemmer. Hver gang. Ring 2684 9809.';
const path = '/hello-world/';
---

<Layout>
  <Fragment slot="head">
    <SeoHead title={title} description={description} path={path} jsonld={[crumb('Velkommen', path)]} />
  </Fragment>
  <Header />
  <main>
    <section class="page-head wrap">
      <h1>Velkommen til Elgård Regnskab</h1>
      <p class="lead">Mere tid til forretning og familie.</p>
    </section>
    <section class="section wrap" style="padding-top: 0;">
      <div class="inner-grid">
        <div>
          <h2 class="head" style="margin-top: 3rem; font-size: var(--step-lead);">Mere tid til forretning og familie</h2>
          <p class="prose">
            Mange selvstændige bruger alt for meget tid på administrative opgaver som
            bogføring og regnskab. Mange mister endda også penge på grund af glemte frister,
            for sent afregnet moms — eller manglende fradrag, fordi de ikke kender de nyeste
            skatteregler.
          </p>
          <h2 class="head" style="margin-top: 3rem; font-size: var(--step-lead);">Vi sørger for, at dine regnskaber stemmer</h2>
          <p class="prose">
            Hos Elgård Regnskabsservice sørger vi for, at du overholder alle frister, får styr
            på skatten, afregnet momsen og klaret den løbende bogføring. Vi udarbejder dine
            regnskaber, så de stemmer. <strong>Hver gang.</strong>
          </p>
          <figure class="street-figure" style="margin-top: 3rem;">
            <Picture src={annemette} formats={['avif', 'webp']} widths={[340, 512, 722]} sizes="(min-width: 48em) 21rem, 88vw" alt="På kontoret hos Elgård Regnskab i Birkerød" loading="lazy" />
            <figcaption>På kontoret, Blokken 90 i Birkerød.</figcaption>
          </figure>
          <p class="prose" style="margin-top: 2rem;">
            Og den tid, du sparer? Den kan du bruge på at drive og udvikle din forretning — og
            nyde livet sammen med familien.
          </p>
          <p class="prose">
            Læs mere om os og vores ydelser
            <a class="link-plain" href={`${B}/regnskabsservice/`}>her på siderne</a>. Eller
            ring og tal med os om, hvad vi kan gøre for dig. Telefon {org.phone} — vi svarer
            alle hverdage 9–16.
          </p>
        </div>
        <div>
          <div class="aside">
            <div class="aside-card">
              <h3>Det vi klarer for dig</h3>
              <ul>
                <li>Frister overholdt, så du ikke mister penge</li>
                <li>Moms og told afregnet til tiden</li>
                <li>Løbende bogføring, så regnskabet stemmer</li>
                <li>Fradrag, du ellers ikke har fået sat</li>
              </ul>
            </div>
            <div class="aside-card">
              <h3>Elgård Regnskab</h3>
              <dl>
                <div><dt>Revisor</dt><dd>{org.founder}</dd></div>
                <div><dt>Telefon</dt><dd><a class="link-plain" href={org.phoneHref}>{org.phone}</a> (alle hverdage 9–16)</dd></div>
                <div><dt>Kontor</dt><dd><a class="link-plain" href={org.officePhoneHref}>{org.officePhone}</a></dd></div>
                <div><dt>Adresse</dt><dd>{org.street}, {org.city}</dd></div>
                <div><dt>CVR</dt><dd>{org.cvr}</dd></div>
              </dl>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
