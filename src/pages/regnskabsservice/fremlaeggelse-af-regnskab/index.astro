---
import Layout from '../../../components/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import SeoHead from '../../../components/SeoHead.astro';
import { org } from '../../../data/site.ts';
const B = import.meta.env.BASE_URL;
const title = 'Fremlæggelse af regnskab | Elgård Regnskab';
const description = 'Personligt fremmøde ved generalforsamling eller bestyrelse: vi præsenterer års- og kvartalsregnskaberne mundtligt, så tallene forklares, når de skal forklares.';
const path = '/regnskabsservice/fremlaeggelse-af-regnskab/';
const crumbObj = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Forside', item: 'https://elgard.dk/' },
    { '@type': 'ListItem', position: 2, name: 'Regnskabsservice', item: 'https://elgard.dk/regnskabsservice/' },
    { '@type': 'ListItem', position: 3, name: 'Fremlæggelse af regnskab', item: `https://elgard.dk${path}` },
  ],
};
---

<Layout>
  <Fragment slot="head">
    <SeoHead title={title} description={description} path={path} jsonld={[crumbObj]} />
  </Fragment>
  <Header />
  <main>
    <section class="page-head wrap">
      <h1>Fremlæggelse af regnskab</h1>
      <p class="lead">Når regnskabet skal præsenteres, er vi der.</p>
    </section>
    <section class="section wrap" style="padding-top: 0;">
      <div class="inner-grid">
        <div>
          <p class="prose">
            Når regnskabet skal præsenteres, er vi der. Nogle virksomheder og foreninger har
            behov for mundtlige præsentationer i forbindelse med års- eller
            kvartalsregnskaber — netop dér er et personligt fremmøde værd.
          </p>
          <p class="prose">
            Her kan vi tilbyde personligt fremmøde i forbindelse med fremlæggelse af jeres
            regnskab for fx en generalforsamling eller en bestyrelse — så tallene forklares,
            når de skal forklares, og spørgsmalerne besvares, imens de stadig er relevante.
          </p>
        </div>
        <div>
          <div class="aside">
            <div class="aside-card">
              <h3>Hvad vi tilbyder</h2>
              <ul>
                <li>Personligt fremmøde ved generalforsamling eller bestyrelse</li>
                <li>Præsentation af års- og kvartalsregnskab</li>
                <li>Tallene forklares, når de skal forklares</li>
              </ul>
            </div>
            <div class="aside-card">
              <h3>Kontakt</h3>
              <dl>
                <div><dt>Direkte</dt><dd><a class="link-plain" href={org.phoneHref}>{org.phone}</a></dd></div>
                <div><dt>Kontor</dt><dd><a class="link-plain" href={org.officePhoneHref}>{org.officePhone}</a></dd></div>
                <div><dt>Adresse</dt><dd>{org.street}, {org.city}</dd></div>
                <div><dt>Åbent</dt><dd>{org.hours}</dd></div>
              </dl>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
