---
import { Picture } from 'astro:assets';
import Layout from '../../components/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SeoHead from '../../components/SeoHead.astro';
import { org } from '../../data/site.ts';
import { crumb } from '../../data/site.ts';
import { branches } from '../../data/site.ts';
import { foundCredit } from '../../data/site.ts';
import annemette from '../../assets/original/annemette.jpg';
import birkerod from '../../assets/original/birkerod.jpg';
const B = import.meta.env.BASE_URL;
const title = 'Om os | Elgård Regnskab';
const description = 'Regnskabs- og bogholderiservice for selvstændige i mange brancher. Kontor i RevisorHuset, Blokken 90, Birkerød — åbent man–tor 9–16, fre 9–15.';
const path = '/om-os/';
---

<Layout>
  <Fragment slot="head">
    <SeoHead title={title} description={description} path={path} jsonld={[crumb('Om os', path)]} />
  </Fragment>
  <Header />
  <main>
    <section class="page-head wrap">
      <h1>Om os</h1>
      <p class="lead">Administration, bogføring, regnskab og selvangivelse — for selvstændige i mange brancher.</p>
    </section>
    <section class="section wrap" style="padding-top: 0;">
      <div class="inner-grid">
        <div>
          <h2 class="head" style="margin-top: 3rem; font-size: var(--step-lead);">Vi udfører regnskab for selvstændige i mange brancher</h2>
          <p class="prose">
            Hos Elgård Regnskab udfører vi administration, bogføring, regnskab og
            selvangivelse for små og mellemstore selvstændige virksomheder og selskaber.
          </p>
          <p class="prose">
            Kunderne repræsenterer en del forskellige brancher: {branches.join(', ')}. Kort
            sagt repræsenterer vore kunder meget forskellige typer regnskabsrelaterede
            opgaver. Vi udfører afregning af virksomheder både med og uden moms, difference
            moms og delvis momsregistrerede, samt afregning af lønsumsafgift.
          </p>
          <div class="photo-row">
            <figure>
              <Picture src={annemette} formats={['avif', 'webp']} widths={[340, 512, 722]} sizes="(min-width: 48em) 240px, 40vw" alt="Annemette på kontoret i Elgård Regnskab" loading="lazy" />
              <figcaption>På kontoret, Blokken 90 i Birkerød.</figcaption>
            </figure>
            <figure>
              <Picture src={birkerod} formats={['avif', 'webp']} widths={[480, 960, 1440, 1920]} sizes="(min-width: 48em) 672px, 60vw" alt="Birkerød Hovedgade" loading="lazy" />
              <figcaption>
                Birkerød Hovedgade — {foundCredit.license}, via {foundCredit.via}.
              </figcaption>
            </figure>
          </div>
        </div>
        <div>
          <div class="aside">
            <div class="aside-card">
              <h3>Kontakt os</h3>
              <p class="mini" style="margin-top: 0;">Vi har kontor på Blokken 90 i Birkerød. {org.hours} kan du møde os på kontoret.</p>
              <dl style="margin-top: 1.25rem;">
                <div><dt>Adresse</dt><dd>{org.street}, {org.city}</dd></div>
                <div><dt>Kontor</dt><dd><a class="link-plain" href={org.officePhoneHref}>{org.officePhone}</a></dd></div>
                <div><dt>Direkte</dt><dd><a class="link-plain" href={org.phoneHref}>{org.phone}</a></dd></div>
                <div><dt>E-mail</dt><dd><a class="link-plain" href={org.emailHref}>{org.email}</a></dd></div>
                <div><dt>CVR</dt><dd>{org.cvr}</dd></div>
                <div><dt>Åbent</dt><dd>{org.hours}</dd></div>
              </dl>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
