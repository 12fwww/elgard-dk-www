---
<div class="page-head wrap">
  <h1>{title}</h1>
  <p class="lead">{description}</p>
</div>
<section class="section wrap" style="padding-top: 0;">
  <slot />
  <div class="contact-card" style="margin-top: 3.5rem;">
    <dl>
      <div>
        <dt>Kontakt</dt>
        <dd>
          <a class="link-plain" href={org.phoneHref}>Direkte {org.phone}</a> ·
          <a class="link-plain" href={org.officePhoneHref}>Kontor {org.officePhone}</a> ·
          <a class="link-plain" href={org.emailHref}>{org.email}</a>
        </dd>
      </div>
      <div>
        <dt>Kontor</dt>
        <dd>{org.street}, {org.city} · CVR {org.cvr}</dd>
      </div>
      <div>
        <dt>Åbent</dt>
        <dd>{org.hours}. {org.phoneHours}.</dd>
      </div>
    </dl>
  </div>
</section>
import { org } from '../data/site.ts';
---
;

export interface Props {
  title: string;
  description: string;
  path: string;
}
const { title, description, path } = Astro.props;
const B = import.meta.env.BASE_URL;