---
import '../styles/global.css';
---

<html lang="da-DK">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2ea3f2" />
    <link rel="icon" type="image/png" href={import.meta.env.BASE_URL + '/favicon.png'} />
    <meta property="og:site_name" content="Elgård Regnskab" />
    {import.meta.env.SITE && <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />}
    <slot name="head" />
  </head>
  <body>
    <slot />
    <script>
      document.documentElement.classList.add('js');
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        },
        { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      // first screen: start the reveals immediately so the hero is never hidden
      requestAnimationFrame(() => document.querySelectorAll('.hero [data-reveal], .hero-section [data-reveal]').forEach((el) => el.classList.add('is-in')));
    </script>
  </body>
</html>
